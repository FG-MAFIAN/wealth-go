<%- include('partials/top') %><section class="auth-wrap"><div class="auth-aside"><span class="eyebrow">WELCOME TO WEALTH GO</span><h1><%= mode==='register'?'A smarter start begins here.':'Good to have you back.' %></h1><p>One place to manage your profile, review activity, submit proof, and track every request.</p><div class="auth-checks"><span>✓ Private account access</span><span>✓ Manual deposit approval</span><span>✓ Transparent request history</span></div></div><div class="form-card"><div class="form-head"><span class="eyebrow"><%= mode==='register'?'NEW ACCOUNT':'SECURE SIGN IN' %></span><h2><%= mode==='register'?'Create your account':'Sign in to Wealth Go' %></h2><p><%= mode==='register'?'A few details and you’re ready to begin.':'Enter your account credentials to continue.' %></p></div><form method="post" action="/<%= mode==='register'?'register':'login' %>" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(mode==='register'){ %><label>Username<input name="username" minlength="3" maxlength="24" pattern="[A-Za-z0-9_]+" required autocomplete="username" placeholder="Choose a username"></label><label>Email address<input type="email" name="email" required autocomplete="email" placeholder="you@example.com"></label><label>Password<input type="password" name="password" minlength="10" required autocomplete="new-password" placeholder="At least 10 characters"><small>Use a unique password you don't use elsewhere.</small></label><input type="hidden" name="ref" value="<%= ref||'' %>"><% } else { %><label>Username or email<input name="username" required autocomplete="username" placeholder="Your username or email"></label><label>Password<input type="password" name="password" required autocomplete="current-password" placeholder="Your password"></label><% } %><button class="btn btn-primary btn-full" type="submit"><%= mode==='register'?'Create account':'Sign in' %> <span>↗</span></button></form><div class="form-switch"><%= mode==='register'?'Already registered?':'New to Wealth Go?' %> <a href="/<%= mode==='register'?'login':'register' %>"><%= mode==='register'?'Sign in':'Create an account' %></a></div></div></section><%- include('partials/bottom') %>
