<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#0a7d4a"><title><%= title %> · <%= siteName %></title><link rel="stylesheet" href="/styles.css"></head><body><header class="site-header"><a class="brand" href="/"><span class="brand-mark">W</span><span><b>WEALTH GO</b><small>GROW WITH CLARITY</small></span></a><nav class="main-nav"><a href="/">Home</a><a href="/products">Packages</a><% if(currentUser){ %><a href="/dashboard">Dashboard</a><a href="/history">History</a><% if(currentUser.role==='admin'){ %><a href="/admin">Admin</a><% } %><form action="/logout" method="post" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="nav-signin" type="submit">Sign out</button></form><% } else { %><a href="/login">Sign in</a><a class="nav-cta" href="/register">Get started <span>↗</span></a><% } %></nav><button class="mobile-menu" aria-label="Toggle menu" onclick="document.body.classList.toggle('menu-open')">☰</button></header><main class="page-shell"><% if(notice){ %><div class="notice <%= notice.type==='error'?'notice-error':'' %>"><%= notice.text %><button onclick="this.parentElement.remove()" aria-label="Dismiss">×</button></div><% } %>
