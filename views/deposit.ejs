<%- include('partials/top') %><section class="dash-head"><div><span class="eyebrow">FUND YOUR ACCOUNT</span><h1>Submit a deposit.</h1><p>Transfer to the account configured by the administrator, then submit your receipt.</p></div><a class="btn btn-secondary" href="/history">View history</a></section><div class="two-col"><section class="content-card"><div class="content-title"><div><span class="eyebrow">TRANSFER DETAILS</span><h2>Account to pay</h2></div><span class="status status-pending">Verify before sending</span></div><% if(settings.number && settings.name && settings.bank){ %><div class="bank-box bank-box-featured"><div class="bank-box-brand"><span class="bank-brand-icon">₦</span><div><small>WEALTH GO · OFFICIAL DEPOSIT ACCOUNT</small><b class="bank-provider"><%= settings.bank %></b></div><span class="bank-verified">PAY HERE</span></div><div class="bank-field"><small>ACCOUNT NAME</small><b><%= settings.name %></b></div><div class="bank-account-field"><div><small>ACCOUNT NUMBER</small><div class="account-number"><%= settings.number %></div></div><button class="copy-account-btn" type="button" onclick="navigator.clipboard.writeText('<%= settings.number %>').then(()=>{this.textContent='Copied ✓'}).catch(()=>{this.textContent='Copy manually'})">Copy number ↗</button></div><div class="bank-security-note"><span>✓</span><p>Double-check the account details before sending. Your deposit is credited only after admin verification.</p></div></div><p class="muted"><%= settings.instructions %></p><% } else { %><div class="empty-state"><span>₦</span><b>Payment account not configured yet</b><p>The administrator must add the receiving bank details before deposits can be made.</p></div><% } %></section><section class="content-card"><div class="content-title"><div><span class="eyebrow">PAYMENT CONFIRMATION</span><h2>Upload your proof</h2></div></div><form action="/deposit" method="post" enctype="multipart/form-data" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Amount sent (₦)<input type="number" name="amount" min="1000" step="1" required placeholder="e.g. 3000"></label><label>Name on payment<input type="text" name="sender_name" maxlength="120" required placeholder="Account name used to transfer"></label><label>Payment screenshot or receipt<input type="file" name="proof" accept="image/jpeg,image/png,image/webp,application/pdf" required><small>JPG, PNG, WEBP, or PDF · maximum 5 MB</small></label><div class="form-hint">Your balance is not credited until the administrator verifies the payment and approves this request.</div><button class="btn btn-primary btn-full" <%= !settings.number?'disabled':'' %>>Submit deposit proof ↗</button></form></section></div><%- include('partials/bottom') %>
