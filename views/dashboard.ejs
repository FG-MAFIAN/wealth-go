n><h2>Referral link</h2></div></div><p class="muted">Share this link to invite people. Referral rewards are disabled by default and should only be enabled with clear, lawful terms.</p><div class="copy-row"><input readonly value="<%= publicBaseUrl %>/register?ref=<%= u.referral_code %>" id="refLink"><button class="btn btn-secondary" onclick="navigator.clipboard.writeText(document.getElementById('refLink').value)">Copy link</button></div></section><%- include('partials/bottom') %>
