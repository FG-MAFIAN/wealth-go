<% if(!transactions.length){ %><div class="empty-state"><span>◷</span><b>No transactions yet</b><p>Your activity will appear here when you submit a request.</p></div><% } else { %><div class="table-wrap"><table><thead><tr><th>Activity</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead><tbody><% transactions.forEach(t=>{ %><tr><td><b><%= t.kind.charAt(0).toUpperCase()+t.kind.slice(1) %></b><small><%= t.description %></small></td><td><%= formatNaira(t.amount) %></td><td><span class="status status-<%= t.status %>"><%= t.status %></span></td><td><%= t.created_at %></td></tr><% }) %></tbody></table></div><% } %>
