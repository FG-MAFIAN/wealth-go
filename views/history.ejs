<%- include('partials/top') %><section class="dash-head"><div><span class="eyebrow">ACCOUNT RECORDS</span><h1>Transaction history.</h1><p>Review deposits, withdrawals, and other account activity.</p></div><a class="btn btn-primary" href="/deposit">＋ New deposit</a></section><section class="content-card"><div class="content-title"><div><span class="eyebrow">ALL ACTIVITY</span><h2>Transactions</h2></div></div><%- include('transactions-table',{transactions}) %></section><div class="two-col"><section class="content-card"><div class="content-title"><div><span class="eyebrow">DEPOSIT REQUESTS</span><h2>Deposits</h2></div></div><% if(!deposits.length){ %><p class="muted">No deposit requests yet.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Amount</th><th>Status</th><th>Proof</th><th>Date</th></tr></thead><tbody><% deposits.forEach(d=>{ %><tr><td><b><%= formatNaira(d.amount) %></b><small><%= d.sender_name %></small></td><td><span class="status status-<%= d.status %>"><%= d.status %></span></td><td><a class="text-link" href="/proof/<%= d.id %>" target="_blank" rel="noopener">View ↗</a></td><td><%= d.created_at %></td></tr><% }) %></tbody></table></div><% } %></section><section class="content-card"><div class="content-title"><div><span class="eyebrow">PAYOUT REQUESTS</span><h2>Withdrawals</h2></div></div><% if(!withdrawals.length){ %><p class="muted">No withdrawal requests yet.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Amount</th><th>Status</th><th>Bank</th><th>Date</th></tr></thead><tbody><% withdrawals.forEach(w=>{ %><tr><td><b><%= formatNaira(w.amount) %></b></td><td><span class="status status-<%= w.status %>"><%= w.status %></span></td><td><small><%= w.bank_name %><br><%= w.account_number %></small></td><td><%= w.created_at %></td></tr><% }) %></tbody></table></div><% } %></section></div><%- include('partials/bottom') %>
