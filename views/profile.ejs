<%- include('partials/top') %><section class="dash-head"><div><span class="eyebrow">ACCOUNT SETTINGS</span><h1>Your profile.</h1><p>Keep your payout information accurate and up to date.</p></div><a class="btn btn-secondary" href="/dashboard">← Dashboard</a></section><div class="two-col"><section class="content-card"><div class="content-title"><div><span class="eyebrow">PERSONAL ACCOUNT</span><h2>Account information</h2></div></div><div class="profile-facts"><div><small>USERNAME</small><b><%= u.username %></b></div><div><small>EMAIL</small><b><%= u.email %></b></div><div><small>ACCOUNT CREATED</small><b><%= u.created_at %></b></div></div></section><section class="content-card"><div class="content-title"><div><span class="eyebrow">WITHDRAWAL DESTINATION</span><h2>Bank details</h2></div></div><form method="post" action="/profile" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Account name<input name="account_name" value="<%= u.bank_account_name %>" required maxlength="120"></label><label>Account number<input name="account_number" value="<%= u.bank_account_number %>" required inputmode="numeric" pattern="[0-9]{8,20}" maxlength="20"></label><label>Bank name<input name="bank_name" value="<%= u.bank_name %>" required maxlength="120"></label><button class="btn btn-primary btn-full">Save bank details</button></form></section></div><%- include('partials/bottom') %>
